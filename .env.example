PORT=3000

# PostgreSQL cache
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aiagency
DB_USER=aiuser
DB_PASSWORD=changeme

# Local Ollama runtime used by the backend proxy
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_MS=180000

# Express JSON body limit
JSON_LIMIT=50mb

# Chat assistant providers (optional — system falls back to Ollama if not set)
# Claude Haiku is tried first (fastest), then Gemini Flash, then Ollama local
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
