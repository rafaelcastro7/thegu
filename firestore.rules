rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /analysis_cache/{groupKey} {
      allow read: if true;
      allow create, update: if 
        request.resource.data.groupKey == groupKey &&
        request.resource.data.groupKey.size() < 128;
    }

    match /report_cache/{groupKey} {
      allow read: if true;
      allow create, update: if groupKey.size() < 128;
    }
  }
}
